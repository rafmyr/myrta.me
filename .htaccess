RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force non-www (canonical: myrta.me, not www.myrta.me)
RewriteCond %{HTTP_HOST} ^www\.myrta\.me [NC]
RewriteRule ^(.*)$ https://myrta.me/$1 [L,R=301]

# Seria AI jest publiczna od 17.08.2026; usunięto wygasłe reguły czasowe.

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-Nx2uQ7G3a8Mw5+6EVHvt+rJ/KCB9R1HPqWlcqEiVA9E=' 'sha256-H4pANOpduJ2K1x5Vu1ex042i0UTFQPSslbqTUs80YBk=' 'sha256-ldKrFFYU3G8LjQh1Rs0pxySPnWB8GcSw2zLJBJ/+6Bk=' 'sha256-rYILEocFwCe/Pq3EQat2dVffjWrnZQDJExN+UOM4sPg='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# Cache static assets (images, CSS, JS)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 month"
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Enable gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/xml application/xml
</IfModule>

# Custom 404
ErrorDocument 404 /404.html
